{
  "axis": "research",
  "label": "Research pillars",
  "select": "multi",
  "max": 3,
  "items": [
    {
      "id": "wcag-22",
      "title": "WCAG 2.2 accessibility floor",
      "year": 2023,
      "source": "https://www.w3.org/TR/WCAG22/",
      "implications": [
        "Focus ring ≥ ~2px effective with strong contrast change",
        "Pointer targets ≥ 24×24 CSS px (prefer 44×44)",
        "Focus must not be fully obscured by sticky chrome",
        "Honor prefers-reduced-motion"
      ],
      "ruleDeltas": {
        "--elev-focus": "0 0 0 3px var(--color-chalk), 0 0 0 6px var(--color-focus)",
        "--a11y-target-min": "44px",
        "--touch-min": "48px",
        "--motion-policy": "respect-reduced",
        "--grain-opacity": "0",
        "--specimen-surface": "var(--color-chalk)",
        "--specimen-blur": "0px",
        "--nav-blur": "0px",
        "--nav-surface": "var(--color-chalk)"
      }
    },
    {
      "id": "m3-roles",
      "title": "Material 3 color roles",
      "year": 2024,
      "source": "https://m3.material.io/styles/color/roles",
      "implications": [
        "Use paired roles (surface + on-surface), not ad-hoc hex",
        "Keep semantic status colors out of brand accent",
        "One primary accent family"
      ],
      "ruleDeltas": {
        "--role-discipline": "strict-pairs",
        "--status-isolation": "true",
        "--specimen-surface": "var(--color-chalk)",
        "--elev-1": "0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent)",
        "--color-hairline": "color-mix(in srgb, var(--color-ink) 14%, transparent)",
        "--page-atmosphere": "linear-gradient(180deg, color-mix(in srgb, var(--color-field) 88%, var(--color-signal) 12%) 0%, var(--color-field) 42%, color-mix(in srgb, var(--color-field) 92%, var(--color-ink) 8%) 100%)"
      }
    },
    {
      "id": "apple-deference",
      "title": "Apple depth / deference (Liquid Glass era)",
      "year": 2025,
      "source": "https://developer.apple.com/documentation/TechnologyOverviews/adopting-liquid-glass",
      "implications": [
        "Chrome yields to content",
        "Translucent materials + blur — not opaque card farms",
        "Test increase-contrast and reduce-motion settings"
      ],
      "ruleDeltas": {
        "--chrome-policy": "glass",
        "--grain-opacity": "0.045",
        "--radius-sm": "0.75rem",
        "--radius-md": "1.15rem",
        "--radius-lg": "1.75rem",
        "--elev-1": "0 1px 0 rgb(255 255 255 / 0.55)",
        "--elev-2": "0 16px 48px rgb(15 23 42 / 0.16), inset 0 1px 0 rgb(255 255 255 / 0.7)",
        "--color-hairline": "rgb(255 255 255 / 0.5)",
        "--color-scrim": "rgb(15 23 42 / 0.3)",
        "--specimen-surface": "rgb(255 255 255 / 0.42)",
        "--specimen-blur": "24px",
        "--specimen-tint": "linear-gradient(155deg, rgb(255 255 255 / 0.62), rgb(255 255 255 / 0.18))",
        "--nav-surface": "rgb(255 255 255 / 0.42)",
        "--nav-blur": "22px",
        "--page-atmosphere": "radial-gradient(110% 70% at 8% -10%, rgb(61 207 191 / 0.28), transparent 55%), radial-gradient(90% 60% at 100% 0%, rgb(148 163 184 / 0.4), transparent 52%), linear-gradient(165deg, #b8c7dc 0%, #d9e4f2 40%, #eef3f9 100%)"
      }
    },
    {
      "id": "fluid-type",
      "title": "Fluid rem type scales",
      "year": 2024,
      "source": "https://noahliebman.net/2024/01/the-math-and-css-of-responsive-type-scales/",
      "implications": [
        "Keep type in rem / clamp with readable floors",
        "Components consume semantic roles, not raw steps"
      ],
      "ruleDeltas": {
        "--type-unit": "rem",
        "--text-hero": "clamp(2.75rem, 6vw + 1rem, 4.25rem)",
        "--text-xl": "clamp(1.9rem, 2vw + 1.2rem, 2.5rem)",
        "--text-base": "1.0625rem",
        "--tracking-display": "-0.03em"
      }
    },
    {
      "id": "content-plain",
      "title": "Plain-language content design",
      "year": 2024,
      "source": "https://design-system.service.gov.uk/",
      "implications": [
        "Visible labels on fields",
        "Short instructional errors",
        "One job per section"
      ],
      "ruleDeltas": {
        "--content-policy": "plain-labels",
        "--measure": "32rem",
        "--tracking-display": "0em",
        "--radius-md": "0.25rem",
        "--grain-opacity": "0",
        "--specimen-blur": "0px",
        "--elev-2": "none",
        "--page-atmosphere": "linear-gradient(180deg, #f4f4f4 0%, #ececec 100%)"
      }
    },
    {
      "id": "eaa-2025",
      "title": "European Accessibility Act in force",
      "year": 2025,
      "source": "https://accessible-eu-centre.ec.europa.eu/content-corner/news/new-era-inclusion-begins-eaa-enters-force-2025-06-27_en",
      "sources": [
        "https://accessible-eu-centre.ec.europa.eu/content-corner/news/new-era-inclusion-begins-eaa-enters-force-2025-06-27_en",
        "https://commission.europa.eu/strategy-and-policy/policies/justice-and-fundamental-rights/disability/european-accessibility-act-eaa_en"
      ],
      "implications": [
        "From 28 June 2025, covered products and services need an accessible interface",
        "Banking, transport, and commerce flows keep labels and status in text",
        "Targets stay large enough for a pointer and a finger"
      ],
      "ruleDeltas": {
        "--touch-min": "48px",
        "--a11y-target-min": "44px",
        "--grain-opacity": "0",
        "--elev-2": "none",
        "--elev-focus": "0 0 0 2px var(--color-chalk), 0 0 0 5px var(--color-focus)",
        "--page-atmosphere": "linear-gradient(180deg, #f7f8f8 0%, #eef0f2 100%)"
      }
    },
    {
      "id": "iso-40500-2025",
      "title": "ISO/IEC 40500:2025 (WCAG 2.2)",
      "year": 2025,
      "source": "https://www.w3.org/WAI/standards-guidelines/wcag/",
      "sources": ["https://www.w3.org/WAI/standards-guidelines/wcag/"],
      "implications": [
        "ISO/IEC 40500:2025 matches the October 2023 WCAG 2.2 text",
        "Use the latest WCAG recommendation when a policy allows it",
        "Focus, target size, and reduced motion stay in the floor"
      ],
      "ruleDeltas": {
        "--text-base": "1.0625rem",
        "--measure": "36rem",
        "--elev-focus": "0 0 0 2px var(--color-chalk), 0 0 0 5px var(--color-focus)",
        "--motion-policy": "respect-reduced"
      }
    },
    {
      "id": "popover-baseline-2025",
      "title": "Popover API is Baseline",
      "year": 2025,
      "source": "https://web.dev/blog/popover-baseline",
      "sources": ["https://web.dev/blog/popover-baseline"],
      "implications": [
        "Menus and confirmations can use the native popover",
        "Light dismiss has to work, including on iOS",
        "Skip custom layered chrome for a simple disclosure"
      ],
      "ruleDeltas": {
        "--radius-md": "0.5rem",
        "--radius-lg": "0.75rem",
        "--elev-2": "none",
        "--specimen-blur": "0px",
        "--nav-blur": "0px"
      }
    },
    {
      "id": "view-transitions-2025",
      "title": "Same-document view transitions are Baseline",
      "year": 2025,
      "source": "https://web.dev/blog/same-document-view-transitions-are-now-baseline-newly-available",
      "sources": [
        "https://web.dev/blog/same-document-view-transitions-are-now-baseline-newly-available"
      ],
      "implications": [
        "Cross-fade a state change inside one document",
        "Keep the change short",
        "Reduced motion gets no choreography"
      ],
      "ruleDeltas": {
        "--dur-1": "120ms",
        "--dur-2": "180ms",
        "--motion-policy": "respect-reduced",
        "--grain-opacity": "0"
      }
    },
    {
      "id": "anchor-position-2025",
      "title": "CSS anchor positioning (Interop 2025)",
      "year": 2025,
      "source": "https://web.dev/blog/interop-2025",
      "sources": [
        "https://web.dev/blog/interop-2025",
        "https://www.w3.org/TR/css-anchor-position-1/"
      ],
      "implications": [
        "Attach a menu or note to the control that opened it",
        "Prefer the platform over a positioning library",
        "Keep the anchored layer quiet: one hairline, no stack of shadows"
      ],
      "ruleDeltas": {
        "--elev-1": "none",
        "--elev-2": "none",
        "--color-hairline": "color-mix(in srgb, var(--color-ink) 18%, transparent)",
        "--radius-md": "0.375rem"
      }
    },
    {
      "id": "m3-expressive-2025",
      "title": "Material 3 Expressive research",
      "year": 2025,
      "source": "https://design.google/library/expressive-material-design-google-research",
      "sources": [
        "https://design.google/library/expressive-material-design-google-research"
      ],
      "implications": [
        "Emotion can mark one hero moment; it does not restyle the whole product",
        "Utilitarian UI stays on the calmer motion scheme",
        "One accent still carries the action"
      ],
      "ruleDeltas": {
        "--dur-1": "140ms",
        "--dur-2": "220ms",
        "--radius-md": "0.75rem",
        "--elev-2": "none",
        "--grain-opacity": "0"
      }
    },
    {
      "id": "en-301-549-2026",
      "title": "EN 301 549 moves to WCAG 2.2",
      "year": 2026,
      "source": "https://accessible-eu-centre.ec.europa.eu/content-corner/news/european-accessibility-standard-en-301-549-has-been-updated-2026-09-07_en",
      "sources": [
        "https://accessible-eu-centre.ec.europa.eu/content-corner/news/european-accessibility-standard-en-301-549-has-been-updated-2026-09-07_en"
      ],
      "implications": [
        "The September 2026 text points European ICT work at WCAG 2.2",
        "Focus must stay visible and targets stay at least 24px, preferably 44",
        "Treat it as the direction, and keep checking the legal citation date"
      ],
      "ruleDeltas": {
        "--touch-min": "48px",
        "--text-base": "1.0625rem",
        "--grain-opacity": "0",
        "--specimen-blur": "0px",
        "--elev-focus": "0 0 0 3px var(--color-chalk), 0 0 0 6px var(--color-focus)",
        "--page-atmosphere": "linear-gradient(180deg, #f5f6f7 0%, #e7eaee 100%)"
      }
    },
    {
      "id": "interop-2026",
      "title": "Interop 2026 UI platform",
      "year": 2026,
      "source": "https://web.dev/blog/interop-2026",
      "sources": ["https://web.dev/blog/interop-2026"],
      "implications": [
        "Dialogs close from a declared action, including a click outside",
        "Style open dialogs and popovers with :open",
        "Cross-document view transitions stay progressive"
      ],
      "ruleDeltas": {
        "--motion-policy": "respect-reduced",
        "--dur-2": "180ms",
        "--radius-md": "0.5rem",
        "--elev-2": "none"
      }
    },
    {
      "id": "baseline-lh-2026",
      "title": "Baseline 2026: :open and line-height units",
      "year": 2026,
      "source": "https://web.dev/blog/baseline-digest-may-2026",
      "sources": [
        "https://web.dev/blog/baseline-digest-may-2026",
        "https://developer.mozilla.org/en-US/docs/Web/CSS/:open",
        "https://developer.mozilla.org/en-US/docs/Web/CSS/length"
      ],
      "implications": [
        "Open dialogs and details can be styled with :open",
        "lh and rlh size chrome to the line of text",
        "Vertical rhythm follows the root line, not a one-off pixel"
      ],
      "ruleDeltas": {
        "--leading-body": "1.5",
        "--text-base": "1rem",
        "--text-sm": "0.875rem",
        "--touch-min": "44px"
      }
    }
  ]
}
