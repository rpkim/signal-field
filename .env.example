# Used by /admin Find. Without it, search returns offline drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallbacks if GEMINI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alternative to OpenAI (used if OPENAI_API_KEY is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Required to open /admin. Set this in .env.local (not committed).
ADMIN_PASSWORD=
